# Copy to private .env; replace development values before deployment.
POSTGRES_USER=rfp
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=rfp
# Compose service hostnames; use localhost when running Python on the host.
DATABASE_URL=postgresql+psycopg://rfp:local-development-only@postgres:5432/rfp
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
# For Qdrant Cloud use its HTTPS endpoint and private API key; blank for local Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=bid_documents
# Required for production ingestion; optional for health/offline parsing.
# Endpoint derives from account ID if blank.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# Docker executable; override with an absolute path for host installations.
TESSERACT_CMD=/usr/bin/tesseract
INGESTION_MAX_FILE_BYTES=52428800
INGESTION_MAX_TOTAL_BYTES=524288000
INGESTION_MAX_FILES=500
INGESTION_STORAGE_ATTEMPTS=3
PARSER_MAX_PAGES=500
PARSER_TIMEOUT_SECONDS=300
HTML_MAX_NODES=200000
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
OCR_MIN_TEXT_CHARS=40
OCR_MIN_WORDS=5
OCR_MAX_IMAGE_PIXELS=16000000
OCR_FORCE=false
# Optional trusted regex overrides by document type, e.g. {"specs":"technical schedule"}.
METADATA_TYPE_PATTERNS={}
# Phase 3 nested settings; estimates are not embedding-model token counts.
CHUNKING__NORMALIZATION_VERSION=1.0
CHUNKING__CHUNKING_VERSION=1.0
CHUNKING__TARGET_TOKENS=600
CHUNKING__MAX_TOKENS=800
CHUNKING__OVERLAP_TOKENS=100
CHUNKING__TABLE_ROW_LIMIT=20
CHUNKING__TOKEN_COUNTER=utf8_bytes_v1
CHUNKING__TOKENIZER_IDENTIFIER=utf8-bytes-div4-v1
CHUNKING__MIN_CONTENT_CHARS=1
CHUNKING__EMPTY_BEHAVIOR=failed
CHUNKING__JOIN_WRAPPED_LINES=true
CHUNKING__MAX_ARTIFACT_BYTES=67108864
CHUNKING__MAX_INPUT_CHARS=5000000
CHUNKING__MAX_OUTPUT_CHARS=20000000
CHUNKING__MAX_CHUNKS=10000
CHUNKING__TIMEOUT_SECONDS=120
CHUNKING__BATCH_SECONDS=240
# Phase 4 local FastEmbed search. Models are downloaded only by `python -m rfp.cli init-models`
# (or when SEARCH__ALLOW_MODEL_DOWNLOAD=true). Compose overrides the cache dir to a volume.
SEARCH__DENSE_MODEL=BAAI/bge-small-en-v1.5
SEARCH__DENSE_DIM=384
SEARCH__SPARSE_MODEL=Qdrant/bm25
SEARCH__RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
SEARCH__MODEL_CACHE_DIR=.cache/fastembed
SEARCH__ALLOW_MODEL_DOWNLOAD=false
SEARCH__EMBED_BATCH_SIZE=32
SEARCH__RERANK_BATCH_SIZE=1
SEARCH__MAX_CONCURRENT_INFERENCE=2
SEARCH__INFERENCE_TIMEOUT_SECONDS=60
SEARCH__DEFAULT_TOP_K=5
SEARCH__MAX_TOP_K=50
SEARCH__CANDIDATE_DEPTH=40
SEARCH__RERANK_DEPTH=20
SEARCH__RRF_K=60
SEARCH__IDENTIFIER_POLICY=require_evidence
SEARCH__IDENTIFIER_RERANK_BONUS=1.0
SEARCH__ALLOW_DEGRADED=false
SEARCH__QDRANT_TIMEOUT_SECONDS=10
SEARCH__UPSERT_BATCH_SIZE=128
SEARCH__UPSERT_ATTEMPTS=3
SEARCH__INDEX_BATCH_SECONDS=600
SEARCH__LOCAL_CACHE_DIR=.cache/embeddings
# Optional JSON synonym map replacing the defaults, e.g. {"deadline":["due date"]}.
# SEARCH__SYNONYMS={}
# Live extraction only. Leave these empty to refuse extract-bid --llm-mode live.
# LLM_PROVIDER is openai or openai_compatible. The key is never logged.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_OUTPUT_TOKENS=2500
# EXTRACTION_MAX_RETRIES=2
# EXTRACTION_CONCURRENCY=4
# EXTRACTION_TOP_K=12
DEPENDENCY_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
