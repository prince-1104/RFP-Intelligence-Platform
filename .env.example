# Copy to private .env; replace development values before deployment.
POSTGRES_USER=rfp
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=rfp
# Compose service hostnames; use localhost when running Python on the host.
DATABASE_URL=postgresql+psycopg://rfp:local-development-only@postgres:5432/rfp
REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
# For Qdrant Cloud use its HTTPS endpoint and private API key; blank for local Qdrant.
QDRANT_API_KEY=
QDRANT_COLLECTION=bid_documents
# Required for production ingestion; optional for health/offline parsing.
# Endpoint derives from account ID if blank.
R2_ACCOUNT_ID=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_REGION=auto
# Docker executable; override with an absolute path for host installations.
TESSERACT_CMD=/usr/bin/tesseract
INGESTION_MAX_FILE_BYTES=52428800
INGESTION_MAX_TOTAL_BYTES=524288000
INGESTION_MAX_FILES=500
INGESTION_STORAGE_ATTEMPTS=3
PARSER_MAX_PAGES=500
PARSER_TIMEOUT_SECONDS=300
HTML_MAX_NODES=200000
OCR_LANGUAGE=eng
OCR_DPI=200
OCR_TIMEOUT_SECONDS=30
OCR_MIN_TEXT_CHARS=40
OCR_MIN_WORDS=5
OCR_MAX_IMAGE_PIXELS=16000000
OCR_FORCE=false
# Optional trusted regex overrides by document type, e.g. {"specs":"technical schedule"}.
METADATA_TYPE_PATTERNS={}
# Reserved for later phases; no LLM calls are implemented.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
DEPENDENCY_TIMEOUT_SECONDS=2
LOG_LEVEL=INFO
